{
  "name": "plaid",
  "productName": "Plaid",
  "version": "1.0.2",
  "author": {
    "name": "Piotr Marczyński",
    "email": "piotmski@gmail.com"
  },
  "description": "Personal Jira worklog editor",
  "keywords": [
    "jira",
    "worklog",
    "planner",
    "calendar"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kimipsen/plaid",
  "repository": "github:kimipsen/plaid",
  "main": "main.js",
  "build": {
    "appId": "com.github.piotrmski.plaid",
    "files": [
      "main.js",
      "bootstrap.js",
      "preload.js",
      "window-state.js",
      "build"
    ],
    "win": {
      "icon": "build/assets/appicon/icon.ico",
      "extraFiles": [
        {
          "from": "src/assets/Plaid.VisualElementsManifest.xml",
          "to": "Plaid.VisualElementsManifest.xml"
        }
      ],
      "publish": [
        {
          "provider": "github",
          "owner": "kimipsen",
          "repo": "plaid"
        }
      ]
    },
    "linux": {
      "icon": "assets/appicon/icon.png"
    },
    "mac": {
      "icon": "assets/appicon/icon.icns"
    }
  },
  "scripts": {
    "ng": "ng",
    "serve-dev": "ng serve",
    "start-dev": "electron main-dev.js",
    "start": "electron main.js",
    "build": "ng build",
    "package": "electron-builder",
    "publish": "electron-builder --publish always",
    "lint": "ng lint",
    "test": "ng test"
  },
  "private": false,
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/source-sans-pro": "^5.3.0",
    "electron-updater": "^6.8.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.5.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.3"
  }
}
