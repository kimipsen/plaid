{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false,
    "schematicCollections": [
      "angular-eslint"
    ]
  },
  "newProjectRoot": "projects",
  "projects": {
    "plaid": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "plaid",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "build",
              "browser": ""
            },
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets/appicon",
                "output": "assets/appicon"
              },
              {
                "glob": "icons.svg",
                "input": "src/assets",
                "output": "assets"
              }
            ],
            "styles": [
              "src/styles.scss",
              "node_modules/@fontsource/source-sans-pro/200.css",
              "node_modules/@fontsource/source-sans-pro/200-italic.css",
              "node_modules/@fontsource/source-sans-pro/300.css",
              "node_modules/@fontsource/source-sans-pro/300-italic.css",
              "node_modules/@fontsource/source-sans-pro/400.css",
              "node_modules/@fontsource/source-sans-pro/400-italic.css",
              "node_modules/@fontsource/source-sans-pro/600.css",
              "node_modules/@fontsource/source-sans-pro/600-italic.css",
              "node_modules/@fontsource/source-sans-pro/700.css",
              "node_modules/@fontsource/source-sans-pro/700-italic.css",
              "node_modules/@fontsource/source-sans-pro/900.css",
              "node_modules/@fontsource/source-sans-pro/900-italic.css",
              "node_modules/@fontsource/comfortaa/300.css",
              "node_modules/@fontsource/comfortaa/400.css",
              "node_modules/@fontsource/comfortaa/500.css",
              "node_modules/@fontsource/comfortaa/600.css",
              "node_modules/@fontsource/comfortaa/700.css"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4300
          },
          "configurations": {
            "production": {
              "buildTarget": "plaid:build:production"
            },
            "development": {
              "buildTarget": "plaid:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
